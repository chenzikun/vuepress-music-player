{
  "name": "vuepress-plugin-music-player",
  "version": "1.0.0",
  "description": "VuePress music player plugin with navbar integration, autoplay, and per-page playlist support",
  "type": "module",
  "license": "MIT",
  "author": "zicorn",
  "homepage": "https://github.com/chenzikun/vuepress-music-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenzikun/vuepress-music-player.git"
  },
  "bugs": {
    "url": "https://github.com/chenzikun/vuepress-music-player/issues"
  },
  "keywords": [
    "vuepress",
    "vuepress-plugin",
    "music-player",
    "navbar",
    "bgm"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && npm run copy:client",
    "copy:client": "cp -r src/client dist/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vue": "^3.2.0",
    "vuepress": "^2.0.0-rc.0 || ^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0"
  }
}
